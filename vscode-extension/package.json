{
  "name": "read-me-aloud",
  "displayName": "Read Me Aloud",
  "description": "Follow-along read-aloud for Markdown, powered by the local read_me server (Kokoro TTS).",
  "version": "0.2.0",
  "repository": { "type": "git", "url": "https://github.com/Dotchi/read_me" },
  "publisher": "local",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:markdown"],
  "contributes": {
    "commands": [
      { "command": "readMe.open", "title": "Read Me: Open Reader", "icon": "$(unmute)" },
      { "command": "readMe.openFile", "title": "Read Me: Open PDF, Word or Text File…" },
      { "command": "readMe.readFromCursor", "title": "Read Me: Read Aloud From Cursor" },
      { "command": "readMe.togglePlay", "title": "Read Me: Play / Pause" },
      { "command": "readMe.stop", "title": "Read Me: Stop" }
    ],
    "keybindings": [
      { "command": "readMe.readFromCursor", "key": "ctrl+alt+r", "when": "editorLangId == markdown" },
      { "command": "readMe.togglePlay", "key": "ctrl+alt+space", "when": "readMe.panelOpen" }
    ],
    "menus": {
      "editor/title": [
        { "command": "readMe.open", "when": "resourceExtname =~ /^\\.(md|markdown|pdf|docx|txt)$/i", "group": "navigation" }
      ],
      "editor/context": [
        { "command": "readMe.readFromCursor", "when": "editorLangId == markdown", "group": "navigation@9" }
      ],
      "explorer/context": [
        { "command": "readMe.open", "when": "resourceExtname =~ /^\\.(md|markdown|pdf|docx|txt)$/i", "group": "navigation@9" }
      ]
    },
    "configuration": {
      "title": "Read Me Aloud",
      "properties": {
        "readMe.serverUrl": { "type": "string", "default": "http://127.0.0.1:8765", "description": "Address of the read_me server." },
        "readMe.projectPath": { "type": "string", "default": "C:\\laragon\\www\\read_me", "description": "Folder of the read_me project, used to start the server automatically." },
        "readMe.serverMode": { "type": "string", "enum": ["docker", "local"], "default": "docker", "enumDescriptions": ["Run `docker compose up -d` in the project folder", "Run the project's .venv Python directly"], "description": "How to start the server when it isn't running." },
        "readMe.autoStartServer": { "type": "boolean", "default": true, "description": "Start the server if it isn't running." },
        "readMe.followInEditor": { "type": "boolean", "default": true, "description": "Highlight and scroll to the source lines being read." }
      }
    }
  }
}
